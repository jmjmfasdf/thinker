#!/usr/bin/env python3
"""Actor-integration mechanisms from the read-only shared analysis cache.

This script tests four temporally explicit, non-interventional scenarios:

1. Search control: event evidence predicts reset/deepening, and accumulated
   branch evidence predicts the branch selected after a reset.
2. Terminal branch evidence: terminal return and visit evidence for each
   branch is compared with Thinker's real-action readout (primary) and the
   prerecorded human action (secondary).
3. Cumulative evidence: directional Q/rollout accumulation and Q-rank
   crossing predict Thinker/human action transitions.
4. Update mechanics: prediction error and visit history explain Q-update
   magnitude, while a high-gain/low-prior "computation-need" proxy predicts
   the next internal search operation.

The script never creates or modifies ``outputs/00_cache``.  The human action
is an imitation target in these traces, so it is explicitly labelled as a
secondary alignment outcome rather than a causal actor output.

Subject mode
------------
python research_script/03_actor_integration_mechanisms.py --subject 3 --game 1

Aggregate mode (reads completed subject outputs)
------------------------------------------------
python research_script/03_actor_integration_mechanisms.py --game 1 \
    --aggregate-subjects 1,2,3,4,5,6
"""

from __future__ import annotations

import argparse
import itertools
import json
import math
from pathlib import Path
from typing import Dict, Iterable, List, Mapping, Optional, Sequence, Tuple

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.optimize import minimize
from scipy.special import logsumexp
import scipy.stats as sps
import statsmodels.api as sm

from shared_analysis_cache import (
    DEFAULT_SHARED_CACHE_ROOT,
    cache_paths,
    validate_manifest,
)


SCRIPT_DIR = Path(__file__).resolve().parent
DEFAULT_OUTPUT_ROOT = SCRIPT_DIR / "outputs" / "03_actor_integration_mechanisms"
KEYS = ["run_label", "real_step"]
N_ACTIONS = 6
EPS = 1e-8


def configure_style() -> None:
    plt.rcParams.update(
        {
            "font.family": "Arial",
            "font.size": 10,
            "axes.titlesize": 11,
            "axes.labelsize": 10,
            "figure.titlesize": 15,
            "axes.spines.top": False,
            "axes.spines.right": False,
            "savefig.bbox": "tight",
        }
    )


def parse_subject(value: object) -> int:
    subject = int(value)
    if subject <= 0:
        raise argparse.ArgumentTypeError("subject must be positive")
    return subject


def parse_subjects(value: str) -> List[int]:
    subjects = sorted({parse_subject(part.strip()) for part in value.split(",") if part.strip()})
    if not subjects:
        raise argparse.ArgumentTypeError("aggregate-subjects cannot be empty")
    return subjects


def atomic_json(path: Path, payload: Mapping[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
    temporary.replace(path)


def save_figure(fig: plt.Figure, path: Path, dpi: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(path, dpi=dpi, facecolor="white")
    plt.close(fig)


def read_columns(path: Path, columns: Sequence[str]) -> pd.DataFrame:
    if not path.exists():
        raise FileNotFoundError(path)
    available = pd.read_csv(path, nrows=0).columns.tolist()
    missing = [column for column in columns if column not in available]
    if missing:
        raise KeyError(f"{path} lacks required columns: {missing}")
    return pd.read_csv(path, usecols=list(columns), low_memory=False)


def standardize(series: pd.Series) -> pd.Series:
    values = pd.to_numeric(series, errors="coerce")
    scale = float(values.std(ddof=0))
    if not np.isfinite(scale) or scale < EPS:
        return pd.Series(np.zeros(len(values)), index=values.index, dtype=float)
    return (values - float(values.mean())) / scale


def scale_only(values: Sequence[float]) -> float:
    array = np.asarray(values, dtype=float)
    array = array[np.isfinite(array)]
    if len(array) == 0:
        return float("nan")
    scale = float(np.std(array, ddof=0))
    return float(np.mean(array) / scale) if scale > EPS else float("nan")


def bh_fdr(p_values: Sequence[float]) -> np.ndarray:
    p = np.asarray(p_values, dtype=float)
    q = np.full(p.shape, np.nan, dtype=float)
    valid = np.flatnonzero(np.isfinite(p))
    if len(valid) == 0:
        return q
    order = valid[np.argsort(p[valid])]
    ranked = p[order] * len(order) / np.arange(1, len(order) + 1)
    ranked = np.minimum.accumulate(ranked[::-1])[::-1]
    q[order] = np.clip(ranked, 0.0, 1.0)
    return q


def exact_sign_flip(values: Sequence[float]) -> Tuple[float, float]:
    array = np.asarray(values, dtype=float)
    array = array[np.isfinite(array)]
    if len(array) == 0:
        return float("nan"), float("nan")
    observed = abs(float(np.mean(array)))
    if len(array) <= 16:
        null = []
        for signs in itertools.product((-1.0, 1.0), repeat=len(array)):
            null.append(abs(float(np.mean(array * np.asarray(signs)))))
        p = float(np.mean(np.asarray(null) >= observed - 1e-15))
    else:
        rng = np.random.default_rng(2026)
        signs = rng.choice((-1.0, 1.0), size=(100000, len(array)))
        null = np.abs(np.mean(signs * array[None, :], axis=1))
        p = float((1 + np.sum(null >= observed)) / (len(null) + 1))
    return float(np.mean(array)), p


def inference_table(
    effects: pd.DataFrame,
    unit: str,
    include_max_t: bool,
) -> pd.DataFrame:
    if effects.empty:
        return pd.DataFrame()
    group_columns = ["scenario", "analysis", "effect", "outcome_role"]
    records: List[Dict[str, object]] = []
    for identifiers, source in effects.groupby(group_columns, dropna=False, sort=False):
        per_unit = source.groupby(unit, sort=False, observed=True)["beta"].mean()
        mean, p = exact_sign_flip(per_unit.to_numpy())
        records.append(
            {
                **dict(zip(group_columns, identifiers)),
                "mean_beta": mean,
                "p_sign_flip": p,
                "n_units": int(per_unit.notna().sum()),
                "unit": unit,
            }
        )
    result = pd.DataFrame(records)
    result["q_bh_within_scenario"] = np.nan
    for scenario, index in result.groupby("scenario", sort=False).groups.items():
        result.loc[index, "q_bh_within_scenario"] = bh_fdr(
            result.loc[index, "p_sign_flip"].to_numpy()
        )
    result["p_max_t"] = np.nan
    if include_max_t:
        for scenario, scenario_rows in result.groupby("scenario", sort=False):
            row_index = scenario_rows.index.to_list()
            units = sorted(effects.loc[effects["scenario"].eq(scenario), unit].unique())
            if not units or len(units) > 16:
                continue
            matrix = np.full((len(units), len(row_index)), np.nan)
            for column_index, result_index in enumerate(row_index):
                row = result.loc[result_index]
                mask = (
                    effects["scenario"].eq(row["scenario"])
                    & effects["analysis"].eq(row["analysis"])
                    & effects["effect"].eq(row["effect"])
                    & effects["outcome_role"].eq(row["outcome_role"])
                )
                values = effects.loc[mask].groupby(unit)["beta"].mean()
                for unit_index, unit_value in enumerate(units):
                    matrix[unit_index, column_index] = values.get(unit_value, np.nan)
            observed = np.abs(np.nanmean(matrix, axis=0))
            exceed = np.zeros(len(row_index), dtype=int)
            total = 0
            for signs in itertools.product((-1.0, 1.0), repeat=len(units)):
                permuted = np.abs(
                    np.nanmean(matrix * np.asarray(signs)[:, None], axis=0)
                )
                maximum = np.nanmax(permuted)
                exceed += maximum >= observed - 1e-15
                total += 1
            result.loc[row_index, "p_max_t"] = exceed / max(total, 1)
    return result


def add_effect(
    records: List[Dict[str, object]],
    source: pd.DataFrame,
    *,
    subject: int,
    game: int,
    run_label: str,
    scenario: str,
    analysis: str,
    effect: str,
    beta: float,
    n_rows: int,
    outcome_role: str = "internal",
    n_events: Optional[int] = None,
) -> None:
    records.append(
        {
            "subject": subject,
            "game": game,
            "run_label": run_label,
            "scenario": scenario,
            "analysis": analysis,
            "effect": effect,
            "outcome_role": outcome_role,
            "beta": float(beta),
            "n_rows": int(n_rows),
            "n_events": int(n_events) if n_events is not None else np.nan,
        }
    )


def fit_binary_run(
    frame: pd.DataFrame,
    outcome: str,
    predictors: Sequence[str],
    categorical: Optional[str] = None,
) -> Tuple[Dict[str, float], int, int]:
    columns = [outcome] + list(predictors) + ([categorical] if categorical else [])
    data = frame[columns].replace([np.inf, -np.inf], np.nan).dropna().copy()
    if len(data) < 80:
        return {}, len(data), 0
    events = int(pd.to_numeric(data[outcome], errors="coerce").sum())
    if events < 5 or events > len(data) - 5:
        return {}, len(data), events
    design = pd.DataFrame(index=data.index)
    for predictor in predictors:
        design[predictor] = standardize(data[predictor])
    if categorical:
        dummies = pd.get_dummies(
            data[categorical].astype(int).astype(str),
            prefix=categorical,
            drop_first=True,
            dtype=float,
        )
        design = pd.concat([design, dummies], axis=1)
    design = sm.add_constant(design, has_constant="add")
    try:
        fit = sm.GLM(
            data[outcome].astype(float),
            design.astype(float),
            family=sm.families.Binomial(),
        ).fit(maxiter=150, disp=0)
    except Exception:
        return {}, len(data), events
    return {name: float(fit.params.get(name, np.nan)) for name in predictors}, len(data), events


def fit_linear_run(
    frame: pd.DataFrame,
    outcome: str,
    predictors: Sequence[str],
    categorical: Optional[str] = None,
) -> Tuple[Dict[str, float], int]:
    columns = [outcome] + list(predictors) + ([categorical] if categorical else [])
    data = frame[columns].replace([np.inf, -np.inf], np.nan).dropna().copy()
    if len(data) < max(40, 5 * len(predictors)):
        return {}, len(data)
    design = pd.DataFrame(index=data.index)
    for predictor in predictors:
        design[predictor] = standardize(data[predictor])
    if categorical:
        dummies = pd.get_dummies(
            data[categorical].astype(int).astype(str),
            prefix=categorical,
            drop_first=True,
            dtype=float,
        )
        design = pd.concat([design, dummies], axis=1)
    design = sm.add_constant(design, has_constant="add")
    try:
        fit = sm.OLS(standardize(data[outcome]).astype(float), design.astype(float)).fit()
    except Exception:
        return {}, len(data)
    return {name: float(fit.params.get(name, np.nan)) for name in predictors}, len(data)


def selected_minus_other(matrix: np.ndarray, choices: np.ndarray) -> np.ndarray:
    output = np.full(len(choices), np.nan, dtype=float)
    for row_index, choice in enumerate(choices):
        if choice < 0 or choice >= matrix.shape[1] or not np.isfinite(matrix[row_index, choice]):
            continue
        alternatives = np.delete(matrix[row_index], choice)
        alternatives = alternatives[np.isfinite(alternatives)]
        if len(alternatives):
            output[row_index] = matrix[row_index, choice] - float(np.mean(alternatives))
    return output


def probabilities_to_margin(probabilities: np.ndarray, choices: np.ndarray) -> np.ndarray:
    output = np.full(len(choices), np.nan, dtype=float)
    for index, choice in enumerate(choices):
        if choice < 0 or choice >= probabilities.shape[1]:
            continue
        row = probabilities[index]
        if not np.all(np.isfinite(row)):
            continue
        other = np.max(np.delete(row, choice))
        output[index] = math.log(max(row[choice], EPS)) - math.log(max(other, EPS))
    return output


def load_subject_cache(subject: int, game: int, cache_root: Path):
    paths = cache_paths(cache_root, subject, game)
    manifest = validate_manifest(paths, subject=subject, game=game)
    window_columns = KEYS + [
        "subject", "game", "real_step_id", "incumbent_action", "human_action",
        "switch", "persistence_evidence", "switch_target_uncertainty",
        "value_revision_event_fraction", "bout_age" if False else "n_status2",
        "root_value", "mean_bout_terminal_depth", "deep_event_fraction",
    ]
    # Persistence windows do not carry bout age; it is supplied by model-control.
    window_columns.remove("n_status2")
    windows = read_columns(paths.persistence_windows, window_columns)
    for action in range(N_ACTIONS):
        extra = read_columns(
            paths.persistence_windows,
            KEYS + [
                f"root_q_initial_{action}", f"root_q_final_{action}",
                f"root_n_initial_{action}", f"root_n_final_{action}",
            ],
        )
        windows = windows.merge(extra, on=KEYS, how="left", validate="one_to_one")
    model_columns = KEYS + [
        "bout_age", "prior_reward", "prior_done", "run_progress",
        "model_candidate", "actor_initial_candidate",
    ]
    for action in range(N_ACTIONS):
        model_columns += [f"model_root_p_{action}", f"actor_terminal_p_{action}"]
    model = read_columns(paths.model_control_windows, model_columns)
    actor = read_columns(paths.actor_metrics, KEYS + ["thinker_action"])
    windows = windows.merge(model, on=KEYS, how="inner", validate="one_to_one")
    windows = windows.merge(actor, on=KEYS, how="left", validate="one_to_one")
    bouts = read_columns(
        paths.persistence_bouts,
        KEYS + [
            "bout_index", "first_status2_position", "terminal_status2_position",
            "reset_known", "branch", "terminal_depth", "terminal_rollout_return",
        ],
    )
    events = read_columns(
        paths.persistence_events,
        KEYS + [
            "bout_index", "status2_position", "depth", "branch", "rollout_return",
            "return_gain_from_root", "root_q_before_sampled", "root_q_after_sampled",
            "root_n_before_sampled", "root_n_after_sampled", "root_q_revision",
            "rollout_prediction_error", "directed_value_revision",
            "directed_prediction_error", "value_revision_valid",
        ],
    )
    rollout_keys = read_columns(paths.rollout_windows, KEYS).reset_index(names="window_index")
    if rollout_keys.duplicated(KEYS).any():
        raise RuntimeError("rollout windows are not one-to-one")
    with np.load(paths.rollout_prefix_events, allow_pickle=False) as archive:
        prefix = {name: archive[name] for name in archive.files}
    return paths, manifest, windows, bouts, events, rollout_keys, prefix


def attach_prefix_pairs(
    events: pd.DataFrame,
    windows: pd.DataFrame,
    rollout_keys: pd.DataFrame,
    prefix: Mapping[str, np.ndarray],
) -> pd.DataFrame:
    pair_names = [
        "return_advantage", "event_progress", "same_branch_next",
        "branch_switch_next", "same_path_deepen_next", "reset_after",
    ]
    required = {"window_index", "event_index", *pair_names}
    missing = required.difference(prefix)
    if missing:
        raise KeyError(f"prefix cache lacks {sorted(missing)}")
    n_windows = len(rollout_keys)
    matrices: Dict[str, np.ndarray] = {}
    prefix_window = np.asarray(prefix["window_index"], dtype=int)
    prefix_event = np.asarray(prefix["event_index"], dtype=int)
    valid = (
        (prefix_window >= 0) & (prefix_window < n_windows)
        & (prefix_event >= 0) & (prefix_event < 28)
    )
    for name in pair_names:
        dtype = np.int8 if name.endswith("next") or name == "reset_after" else np.float32
        fill = -1 if np.issubdtype(dtype, np.integer) else np.nan
        matrix = np.full((n_windows, 28), fill, dtype=dtype)
        matrix[prefix_window[valid], prefix_event[valid]] = np.asarray(prefix[name])[valid]
        matrices[name] = matrix
    pairs = events.loc[pd.to_numeric(events["status2_position"], errors="coerce").between(0, 27)].copy()
    pairs = pairs.merge(rollout_keys, on=KEYS, how="left", validate="many_to_one")
    if pairs["window_index"].isna().any():
        raise RuntimeError("persistence events do not align with rollout windows")
    wi = pairs["window_index"].to_numpy(dtype=int)
    ei = pairs["status2_position"].to_numpy(dtype=int)
    for name, matrix in matrices.items():
        pairs[name] = matrix[wi, ei]
    metadata = windows[KEYS + [
        "subject", "game", "incumbent_action", "human_action", "thinker_action",
        "persistence_evidence", "switch_target_uncertainty", "bout_age",
        "prior_reward", "prior_done", "run_progress",
    ] + [f"model_root_p_{action}" for action in range(N_ACTIONS)]]
    pairs = pairs.merge(metadata, on=KEYS, how="left", validate="many_to_one")
    branch = pairs["branch"].to_numpy(dtype=int)
    prior = pairs[[f"model_root_p_{action}" for action in range(N_ACTIONS)]].to_numpy(dtype=float)
    pairs["model_prior_branch"] = prior[np.arange(len(pairs)), branch]
    pairs["absolute_q_revision"] = np.abs(pd.to_numeric(pairs["root_q_revision"], errors="coerce"))
    pairs["absolute_prediction_error"] = np.abs(
        pd.to_numeric(pairs["rollout_prediction_error"], errors="coerce")
    )
    pairs["log_prior_visits"] = np.log1p(
        pd.to_numeric(pairs["root_n_before_sampled"], errors="coerce").clip(lower=0)
    )
    pairs["first_visit"] = pd.to_numeric(pairs["root_n_before_sampled"], errors="coerce").le(0).astype(int)
    pairs["greedy_gain"] = pd.to_numeric(pairs["return_advantage"], errors="coerce").clip(lower=0)
    pairs["low_model_prior"] = 1.0 - pairs["model_prior_branch"]
    pairs["computation_need_proxy"] = pairs["greedy_gain"] * pairs["low_model_prior"]
    pairs["predicted_update_scale"] = pairs["absolute_prediction_error"] / (
        1.0 + pd.to_numeric(pairs["root_n_before_sampled"], errors="coerce").clip(lower=0)
    )
    return pairs


def reset_choice_contrasts(
    events: pd.DataFrame,
    windows: pd.DataFrame,
) -> pd.DataFrame:
    lookup = windows.set_index(KEYS)
    records: List[Dict[str, object]] = []
    ordered = events.sort_values(KEYS + ["status2_position"], kind="stable")
    for key, source in ordered.groupby(KEYS, sort=False, observed=True):
        if key not in lookup.index:
            continue
        row = lookup.loc[key]
        q = np.asarray([row[f"root_q_initial_{a}"] for a in range(N_ACTIONS)], dtype=float)
        n = np.asarray([row[f"root_n_initial_{a}"] for a in range(N_ACTIONS)], dtype=float)
        prior = np.asarray([row[f"model_root_p_{a}"] for a in range(N_ACTIONS)], dtype=float)
        return_sum = np.zeros(N_ACTIONS, dtype=float)
        return_count = np.zeros(N_ACTIONS, dtype=float)
        previous_bout = None
        previous_branch = None
        for event in source.itertuples(index=False):
            bout = int(event.bout_index)
            branch = int(event.branch)
            if previous_bout is not None and bout != previous_bout:
                q_contrast = selected_minus_other(q[None, :], np.asarray([branch]))[0]
                n_contrast = selected_minus_other(n[None, :], np.asarray([branch]))[0]
                prior_contrast = selected_minus_other(prior[None, :], np.asarray([branch]))[0]
                means = np.divide(
                    return_sum, return_count,
                    out=np.full(N_ACTIONS, np.nan), where=return_count > 0,
                )
                return_contrast = selected_minus_other(means[None, :], np.asarray([branch]))[0]
                records.append(
                    {
                        "run_label": key[0], "real_step": key[1],
                        "next_bout_index": bout, "chosen_branch": branch,
                        "previous_branch": previous_branch,
                        "same_branch_choice": int(branch == previous_branch),
                        "q_contrast": q_contrast, "visit_contrast": n_contrast,
                        "model_prior_contrast": prior_contrast,
                        "prior_return_contrast": return_contrast,
                    }
                )
            q_after = float(event.root_q_after_sampled)
            n_after = float(event.root_n_after_sampled)
            if np.isfinite(q_after):
                q[branch] = q_after
            if np.isfinite(n_after):
                n[branch] = n_after
            value = float(event.rollout_return)
            if np.isfinite(value):
                return_sum[branch] += value
                return_count[branch] += 1
            previous_bout = bout
            previous_branch = branch
    return pd.DataFrame(records)


def terminal_branch_matrices(
    bouts: pd.DataFrame,
    windows: pd.DataFrame,
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    base = windows[KEYS].reset_index(drop=True).reset_index(names="window_index")
    grouped = (
        bouts.groupby(KEYS + ["branch"], sort=False, observed=True)["terminal_rollout_return"]
        .agg(["mean", "max", "count"]).reset_index()
        .merge(base, on=KEYS, how="left", validate="many_to_one")
    )
    matrices = [np.full((len(base), N_ACTIONS), np.nan, dtype=float) for _ in range(3)]
    wi = grouped["window_index"].to_numpy(dtype=int)
    branch = grouped["branch"].to_numpy(dtype=int)
    for matrix, name in zip(matrices, ("mean", "max", "count")):
        matrix[wi, branch] = pd.to_numeric(grouped[name], errors="coerce").to_numpy(dtype=float)
    matrices[2] = np.nan_to_num(matrices[2], nan=0.0)
    return tuple(matrices)  # type: ignore[return-value]


def aggregate_directional_evidence(events: pd.DataFrame, windows: pd.DataFrame) -> pd.DataFrame:
    data = events.copy()
    data["abs_q"] = np.abs(pd.to_numeric(data["root_q_revision"], errors="coerce"))
    data["abs_pe"] = np.abs(pd.to_numeric(data["rollout_prediction_error"], errors="coerce"))
    aggregate = data.groupby(KEYS, sort=False, observed=True).agg(
        directional_q_sum=("directed_value_revision", "sum"),
        q_abs_sum=("abs_q", "sum"),
        directional_pe_sum=("directed_prediction_error", "sum"),
        pe_abs_sum=("abs_pe", "sum"),
        valid_revision_events=("value_revision_valid", "sum"),
        status2_events=("status2_position", "count"),
    ).reset_index()
    aggregate["directional_q_balance"] = aggregate["directional_q_sum"] / aggregate["q_abs_sum"].replace(0, np.nan)
    aggregate["directional_rollout_balance"] = aggregate["directional_pe_sum"] / aggregate["pe_abs_sum"].replace(0, np.nan)
    frame = windows.merge(aggregate, on=KEYS, how="left", validate="one_to_one")
    q_initial = frame[[f"root_q_initial_{a}" for a in range(N_ACTIONS)]].to_numpy(dtype=float)
    q_final = frame[[f"root_q_final_{a}" for a in range(N_ACTIONS)]].to_numpy(dtype=float)
    n_initial = frame[[f"root_n_initial_{a}" for a in range(N_ACTIONS)]].to_numpy(dtype=float)
    n_final = frame[[f"root_n_final_{a}" for a in range(N_ACTIONS)]].to_numpy(dtype=float)
    incumbent = frame["incumbent_action"].to_numpy(dtype=int)
    gap_initial = np.full(len(frame), np.nan)
    gap_final = np.full(len(frame), np.nan)
    for index, action in enumerate(incumbent):
        alternatives = np.arange(N_ACTIONS) != action
        valid_i = alternatives & (n_initial[index] > 0) & np.isfinite(q_initial[index])
        valid_f = alternatives & (n_final[index] > 0) & np.isfinite(q_final[index])
        if n_initial[index, action] > 0 and valid_i.any():
            gap_initial[index] = q_initial[index, action] - np.max(q_initial[index, valid_i])
        if n_final[index, action] > 0 and valid_f.any():
            gap_final[index] = q_final[index, action] - np.max(q_final[index, valid_f])
    frame["q_gap_initial"] = gap_initial
    frame["q_gap_final"] = gap_final
    frame["q_gap_change"] = gap_final - gap_initial
    frame["q_rank_cross_direction"] = np.where(
        np.isfinite(gap_initial) & np.isfinite(gap_final),
        np.where((gap_initial >= 0) & (gap_final < 0), 1,
                 np.where((gap_initial < 0) & (gap_final >= 0), -1, 0)),
        np.nan,
    )
    frame["thinker_transition"] = (
        pd.to_numeric(frame["thinker_action"], errors="coerce")
        .ne(pd.to_numeric(frame["incumbent_action"], errors="coerce"))
    ).astype(int)
    frame["human_transition"] = (
        pd.to_numeric(frame["human_action"], errors="coerce")
        .ne(pd.to_numeric(frame["incumbent_action"], errors="coerce"))
    ).astype(int)
    return frame


def scenario1(
    pairs: pd.DataFrame,
    reset_choices: pd.DataFrame,
    subject: int,
    game: int,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    records: List[Dict[str, object]] = []
    plotting: List[pd.DataFrame] = []
    predictors = ["return_advantage", "model_prior_branch", "depth", "event_progress"]
    for run_label, source in pairs.groupby("run_label", sort=False):
        for outcome in ("reset_after", "same_path_deepen_next"):
            betas, n_rows, n_events = fit_binary_run(source, outcome, predictors, "branch")
            for effect, beta in betas.items():
                add_effect(records, source, subject=subject, game=game, run_label=run_label,
                           scenario="S1_search_control", analysis=f"event_to_{outcome}",
                           effect=effect, beta=beta, n_rows=n_rows, n_events=n_events)
        plot = source[["run_label", "return_advantage", "reset_after", "same_path_deepen_next"]].copy()
        plotting.append(plot)
    if not reset_choices.empty:
        for run_label, source in reset_choices.groupby("run_label", sort=False):
            for metric in ("q_contrast", "visit_contrast", "model_prior_contrast", "prior_return_contrast"):
                add_effect(records, source, subject=subject, game=game, run_label=run_label,
                           scenario="S1_search_control", analysis="reset_to_next_bout_branch_choice",
                           effect=metric, beta=scale_only(source[metric]), n_rows=source[metric].notna().sum())
    return pd.DataFrame(records), pd.concat(plotting, ignore_index=True) if plotting else pd.DataFrame()


def scenario2(
    windows: pd.DataFrame,
    bouts: pd.DataFrame,
    subject: int,
    game: int,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    records: List[Dict[str, object]] = []
    plotting: List[pd.DataFrame] = []
    mean_matrix, max_matrix, visit_matrix = terminal_branch_matrices(bouts, windows)
    prior_matrix = windows[[f"model_root_p_{a}" for a in range(N_ACTIONS)]].to_numpy(dtype=float)
    terminal_policy = windows[[f"actor_terminal_p_{a}" for a in range(N_ACTIONS)]].to_numpy(dtype=float)
    for role, choice_column in (("thinker_primary", "thinker_action"), ("human_secondary", "human_action")):
        choices = pd.to_numeric(windows[choice_column], errors="coerce").fillna(-1).to_numpy(dtype=int)
        local = windows[KEYS + ["run_label"]].copy()
        local["terminal_mean_contrast"] = selected_minus_other(mean_matrix, choices)
        local["terminal_max_contrast"] = selected_minus_other(max_matrix, choices)
        local["visit_contrast"] = selected_minus_other(visit_matrix, choices)
        local["model_prior_contrast"] = selected_minus_other(prior_matrix, choices)
        local["real_head_margin"] = probabilities_to_margin(terminal_policy, choices)
        local["outcome_role"] = role
        for run_label, source in local.groupby("run_label", sort=False):
            for metric in ("terminal_mean_contrast", "terminal_max_contrast", "visit_contrast", "model_prior_contrast"):
                add_effect(records, source, subject=subject, game=game, run_label=run_label,
                           scenario="S2_terminal_branch_choice", analysis="conditional_choice_contrast",
                           effect=metric, beta=scale_only(source[metric]), n_rows=source[metric].notna().sum(),
                           outcome_role=role)
            betas, n_rows = fit_linear_run(
                source, "real_head_margin",
                ["terminal_mean_contrast", "terminal_max_contrast", "visit_contrast", "model_prior_contrast"],
            )
            for effect, beta in betas.items():
                add_effect(records, source, subject=subject, game=game, run_label=run_label,
                           scenario="S2_terminal_branch_choice", analysis="evidence_to_real_head_margin",
                           effect=effect, beta=beta, n_rows=n_rows, outcome_role=role)
        plotting.append(local)
    return pd.DataFrame(records), pd.concat(plotting, ignore_index=True)


def scenario3(
    evidence: pd.DataFrame,
    subject: int,
    game: int,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    records: List[Dict[str, object]] = []
    plotting: List[pd.DataFrame] = []
    accumulation = ["directional_q_balance", "directional_rollout_balance"]
    controls = ["persistence_evidence", "switch_target_uncertainty", "bout_age", "prior_reward", "prior_done", "run_progress"]
    for role, outcome in (("thinker_primary", "thinker_transition"), ("human_secondary", "human_transition")):
        for run_label, source in evidence.groupby("run_label", sort=False):
            betas, n_rows, n_events = fit_binary_run(source, outcome, accumulation + controls, "incumbent_action")
            for effect in accumulation:
                if effect in betas:
                    add_effect(records, source, subject=subject, game=game, run_label=run_label,
                               scenario="S3_cumulative_evidence", analysis="accumulation_to_transition",
                               effect=effect, beta=betas[effect], n_rows=n_rows, n_events=n_events,
                               outcome_role=role)
            rank_source = source.loc[source["q_rank_cross_direction"].notna()].copy()
            rank_betas, rank_rows, rank_events = fit_binary_run(
                rank_source, outcome, ["q_rank_cross_direction", "q_gap_change"] + controls,
                "incumbent_action",
            )
            for effect in ("q_rank_cross_direction", "q_gap_change"):
                if effect in rank_betas:
                    add_effect(records, rank_source, subject=subject, game=game, run_label=run_label,
                               scenario="S3_cumulative_evidence", analysis="rank_crossing_to_transition",
                               effect=effect, beta=rank_betas[effect], n_rows=rank_rows,
                               n_events=rank_events, outcome_role=role)
        plot = evidence[["run_label", "directional_q_balance", "directional_rollout_balance",
                         "q_rank_cross_direction", outcome]].copy()
        plot = plot.rename(columns={outcome: "transition"})
        plot["outcome_role"] = role
        plotting.append(plot)
    return pd.DataFrame(records), pd.concat(plotting, ignore_index=True)


def scenario4(
    pairs: pd.DataFrame,
    subject: int,
    game: int,
) -> Tuple[pd.DataFrame, pd.DataFrame]:
    records: List[Dict[str, object]] = []
    plotting: List[pd.DataFrame] = []
    valid_updates = pairs.loc[
        pd.to_numeric(pairs["value_revision_valid"], errors="coerce").eq(1)
    ].copy()
    mechanics_predictors = ["predicted_update_scale", "log_prior_visits", "depth", "event_progress"]
    next_predictors = ["computation_need_proxy", "greedy_gain", "low_model_prior", "depth", "event_progress"]
    for run_label, source in pairs.groupby("run_label", sort=False):
        update_source = valid_updates.loc[valid_updates["run_label"].eq(run_label)]
        betas, n_rows = fit_linear_run(update_source, "absolute_q_revision", mechanics_predictors, "branch")
        for effect, beta in betas.items():
            add_effect(records, update_source, subject=subject, game=game, run_label=run_label,
                       scenario="S4_update_mechanics", analysis="prediction_error_to_q_update",
                       effect=effect, beta=beta, n_rows=n_rows)
        for outcome in ("reset_after", "same_path_deepen_next", "branch_switch_next"):
            next_betas, pair_rows, n_events = fit_binary_run(source, outcome, next_predictors, "branch")
            for effect in ("computation_need_proxy", "greedy_gain", "low_model_prior"):
                if effect in next_betas:
                    add_effect(records, source, subject=subject, game=game, run_label=run_label,
                               scenario="S4_update_mechanics", analysis=f"need_to_{outcome}",
                               effect=effect, beta=next_betas[effect], n_rows=pair_rows,
                               n_events=n_events)
        plotting.append(source[["run_label", "predicted_update_scale", "absolute_q_revision",
                                "computation_need_proxy", "reset_after", "same_path_deepen_next",
                                "branch_switch_next"]].copy())
    return pd.DataFrame(records), pd.concat(plotting, ignore_index=True)


def quantile_summary(frame: pd.DataFrame, x: str, outcomes: Sequence[str], bins: int = 10) -> pd.DataFrame:
    records: List[Dict[str, object]] = []
    for run_label, source in frame.groupby("run_label", sort=False):
        valid = source[[x] + list(outcomes)].replace([np.inf, -np.inf], np.nan).dropna(subset=[x]).copy()
        if len(valid) < bins * 10:
            continue
        try:
            valid["bin"] = pd.qcut(valid[x], q=bins, labels=False, duplicates="drop")
        except ValueError:
            continue
        for bin_index, rows in valid.groupby("bin", sort=True):
            for outcome in outcomes:
                values = pd.to_numeric(rows[outcome], errors="coerce").dropna()
                if len(values):
                    records.append({"run_label": run_label, "bin": int(bin_index),
                                    "x_mean": float(rows[x].mean()), "outcome": outcome,
                                    "y_mean": float(values.mean()), "n": int(len(values))})
    return pd.DataFrame(records)


def draw_binned_lines(axis: plt.Axes, summary: pd.DataFrame, title: str, xlabel: str) -> None:
    colors = {name: color for name, color in zip(summary["outcome"].unique(), ("#356AA0", "#C9504D", "#4F8A5B", "#8B6FA8"))}
    for outcome, source in summary.groupby("outcome", sort=False):
        grouped = source.groupby("bin", sort=True).agg(x=("x_mean", "mean"), y=("y_mean", "mean"),
                                                       se=("y_mean", "sem")).reset_index()
        axis.plot(grouped["x"], grouped["y"], marker="o", lw=2, label=outcome.replace("_", " "), color=colors[outcome])
        axis.fill_between(grouped["x"], grouped["y"] - grouped["se"].fillna(0),
                          grouped["y"] + grouped["se"].fillna(0), color=colors[outcome], alpha=.18)
    axis.set_title(title, loc="center")
    axis.set_xlabel(xlabel)
    axis.set_ylabel("Observed probability / mean")
    axis.legend(frameon=False, fontsize=8)


def effect_bar(axis: plt.Axes, effects: pd.DataFrame, analysis: str, title: str, role: Optional[str] = None) -> None:
    source = effects.loc[effects["analysis"].eq(analysis)].copy()
    if role is not None:
        source = source.loc[source["outcome_role"].eq(role)]
    if source.empty:
        axis.text(.5, .5, "No estimable effects", ha="center", va="center", transform=axis.transAxes)
        axis.set_axis_off()
        return
    order = list(dict.fromkeys(source["effect"].tolist()))
    means = source.groupby("effect")["beta"].mean().reindex(order)
    ses = source.groupby("effect")["beta"].sem().reindex(order)
    x = np.arange(len(order))
    axis.bar(x, means, color="#555555", alpha=.82)
    axis.errorbar(x, means, yerr=ses.fillna(0), fmt="none", color="black", capsize=3)
    for xi, effect in zip(x, order):
        values = source.loc[source["effect"].eq(effect), "beta"].to_numpy(dtype=float)
        jitter = np.linspace(-.12, .12, len(values)) if len(values) > 1 else np.zeros(1)
        axis.scatter(xi + jitter, values, s=17, color="white", edgecolor="#333333", zorder=3)
    axis.axhline(0, color="#222222", lw=.8, ls="--")
    axis.set_xticks(x, [label.replace("_", " ") for label in order], rotation=30, ha="right")
    axis.set_ylabel("Run-standardized effect")
    axis.set_title(title, loc="center")


def subject_figures(
    output: Path,
    effects: pd.DataFrame,
    plots: Mapping[str, pd.DataFrame],
    dpi: int,
) -> None:
    figures = output / "figures"
    # Scenario 1
    fig, axes = plt.subplots(1, 2, figsize=(11, 4.4))
    summary = quantile_summary(plots["S1"], "return_advantage", ["reset_after", "same_path_deepen_next"])
    draw_binned_lines(axes[0], summary, "Next search operation", "Current rollout advantage")
    effect_bar(axes[1], effects, "reset_to_next_bout_branch_choice", "Evidence for the next root branch")
    fig.suptitle("Search evidence controls reset, deepening, and branch re-entry", x=.5, ha="center")
    fig.tight_layout(rect=(0, 0, 1, .93))
    save_figure(fig, figures / "figure1_search_control.png", dpi)
    # Scenario 2
    fig, axes = plt.subplots(1, 2, figsize=(11, 4.4))
    effect_bar(axes[0], effects, "conditional_choice_contrast", "Thinker branch evidence", "thinker_primary")
    effect_bar(axes[1], effects, "conditional_choice_contrast", "Human-aligned branch evidence", "human_secondary")
    fig.suptitle("Terminal branch evidence and action choice", x=.5, ha="center")
    fig.tight_layout(rect=(0, 0, 1, .93))
    save_figure(fig, figures / "figure2_terminal_branch_choice.png", dpi)
    # Scenario 3
    fig, axes = plt.subplots(1, 2, figsize=(11, 4.4))
    for axis, role, title in zip(axes, ("thinker_primary", "human_secondary"),
                                 ("Thinker transition", "Human transition (secondary)")):
        source = plots["S3"].loc[plots["S3"]["outcome_role"].eq(role)]
        summary = quantile_summary(source, "directional_q_balance", ["transition"])
        draw_binned_lines(axis, summary, title, "Directional Q-revision balance")
    fig.suptitle("Cumulative value revision and action transitions", x=.5, ha="center")
    fig.tight_layout(rect=(0, 0, 1, .93))
    save_figure(fig, figures / "figure3_cumulative_evidence.png", dpi)
    # Scenario 4
    fig, axes = plt.subplots(1, 2, figsize=(11, 4.4))
    summary = quantile_summary(plots["S4"], "predicted_update_scale", ["absolute_q_revision"])
    draw_binned_lines(axes[0], summary, "Q-update mechanics", "|Prediction error| / (1 + prior visits)")
    summary = quantile_summary(plots["S4"], "computation_need_proxy",
                               ["reset_after", "same_path_deepen_next", "branch_switch_next"])
    draw_binned_lines(axes[1], summary, "Next computation", "Positive gain × low model prior")
    fig.suptitle("Value updating and allocation of the next computation", x=.5, ha="center")
    fig.tight_layout(rect=(0, 0, 1, .93))
    save_figure(fig, figures / "figure4_update_mechanics.png", dpi)


def group_figures(output: Path, effects: pd.DataFrame, dpi: int) -> None:
    figures = output / "figures"
    for index, scenario in enumerate(sorted(effects["scenario"].unique()), start=1):
        source = effects.loc[effects["scenario"].eq(scenario)].copy()
        source["label"] = source["analysis"] + "\n" + source["effect"] + "\n" + source["outcome_role"]
        matrix = source.pivot_table(index="subject", columns="label", values="beta", aggfunc="mean")
        fig, axis = plt.subplots(figsize=(max(8, .55 * len(matrix.columns) + 2), max(3.5, .45 * len(matrix) + 2)))
        image = axis.imshow(matrix.to_numpy(dtype=float), aspect="auto", cmap="RdBu_r", vmin=-1, vmax=1)
        axis.set_yticks(np.arange(len(matrix)), [f"sub{int(value):03d}" for value in matrix.index])
        axis.set_xticks(np.arange(len(matrix.columns)), [value.replace("_", " ") for value in matrix.columns],
                        rotation=45, ha="right", fontsize=8)
        axis.set_title(scenario.replace("_", " "), loc="center")
        fig.colorbar(image, ax=axis, label="Subject-mean standardized effect", shrink=.8)
        fig.tight_layout()
        save_figure(fig, figures / f"figure{index}_{scenario.lower()}_group.png", dpi)


def run_subject(args: argparse.Namespace) -> None:
    subject = int(args.subject)
    game = int(args.game)
    output = args.output_root / f"sub{subject:03d}_game{game}"
    tables = output / "tables"
    tables.mkdir(parents=True, exist_ok=True)
    paths, manifest, windows, bouts, events, rollout_keys, prefix = load_subject_cache(
        subject, game, args.shared_cache_root
    )
    pairs = attach_prefix_pairs(events, windows, rollout_keys, prefix)
    reset_choices = reset_choice_contrasts(events, windows)
    cumulative = aggregate_directional_evidence(events, windows)
    effects_list: List[pd.DataFrame] = []
    plots: Dict[str, pd.DataFrame] = {}
    effects, plots["S1"] = scenario1(pairs, reset_choices, subject, game); effects_list.append(effects)
    effects, plots["S2"] = scenario2(windows, bouts, subject, game); effects_list.append(effects)
    effects, plots["S3"] = scenario3(cumulative, subject, game); effects_list.append(effects)
    effects, plots["S4"] = scenario4(pairs, subject, game); effects_list.append(effects)
    run_effects = pd.concat(effects_list, ignore_index=True)
    inference = inference_table(run_effects, "run_label", args.max_t)
    run_effects.to_csv(tables / "run_effects.csv", index=False)
    inference.to_csv(tables / "subject_inference.csv", index=False)
    reset_choices.to_csv(tables / "reset_branch_choice_contrasts.csv", index=False)
    coverage = pd.DataFrame(
        [
            {"dataset": "real_step_windows", "rows": len(windows), "runs": windows["run_label"].nunique()},
            {"dataset": "status2_events", "rows": len(events), "runs": events["run_label"].nunique()},
            {"dataset": "adjacent_event_pairs", "rows": len(pairs), "runs": pairs["run_label"].nunique()},
            {"dataset": "reset_branch_choices", "rows": len(reset_choices), "runs": reset_choices["run_label"].nunique() if len(reset_choices) else 0},
            {"dataset": "rank_crossing_valid_windows", "rows": int(cumulative["q_rank_cross_direction"].notna().sum()), "runs": cumulative.loc[cumulative["q_rank_cross_direction"].notna(), "run_label"].nunique()},
            {"dataset": "valid_repeated_q_updates", "rows": int(pd.to_numeric(pairs["value_revision_valid"], errors="coerce").eq(1).sum()), "runs": pairs.loc[pd.to_numeric(pairs["value_revision_valid"], errors="coerce").eq(1), "run_label"].nunique()},
        ]
    )
    coverage.to_csv(tables / "coverage.csv", index=False)
    subject_figures(output, run_effects, plots, args.dpi)
    atomic_json(
        output / "analysis_manifest.json",
        {
            "subject": subject,
            "game": game,
            "shared_cache": str(paths.root),
            "shared_cache_version": manifest.get("shared_cache_version"),
            "cache_created_at": manifest.get("created_at"),
            "human_outcome_role": "secondary imitation-target alignment; not an actor-generated action",
            "fixed_early_cutoff": False,
            "max_t_enabled": bool(args.max_t),
            "scenarios": {
                "S1": "event evidence -> reset/deepen; accumulated root evidence -> branch after reset",
                "S2": "terminal branch mean/max/visits/model prior -> Thinker choice; human secondary",
                "S3": "directional Q/rollout accumulation and rank crossing -> transition",
                "S4": "prediction-error update mechanics and gain-by-low-prior need -> next computation",
            },
            "limitations": [
                "observational temporal tests do not establish causal integration",
                "Q-update mechanics exclude first visits when a pre-update Q is undefined",
                "terminal actor policy is the next status-0 real-action readout and is a sensitivity endpoint",
                "human actions are prerecorded imitation targets",
            ],
            "coverage": coverage.to_dict(orient="records"),
        },
    )


def run_aggregate(args: argparse.Namespace) -> None:
    subjects = parse_subjects(args.aggregate_subjects)
    frames = []
    missing = []
    for subject in subjects:
        path = args.output_root / f"sub{subject:03d}_game{args.game}" / "tables" / "run_effects.csv"
        if not path.exists():
            missing.append(str(path))
            continue
        frames.append(pd.read_csv(path))
    if missing:
        raise FileNotFoundError("Missing subject outputs:\n" + "\n".join(missing))
    effects = pd.concat(frames, ignore_index=True)
    subject_effects = (
        effects.groupby(["subject", "game", "scenario", "analysis", "effect", "outcome_role"],
                        dropna=False, sort=False)["beta"].mean().reset_index()
    )
    group = inference_table(subject_effects, "subject", args.max_t)
    output = args.output_root / f"group_game{args.game}"
    tables = output / "tables"
    tables.mkdir(parents=True, exist_ok=True)
    subject_effects.to_csv(tables / "subject_effects.csv", index=False)
    group.to_csv(tables / "group_inference.csv", index=False)
    group_figures(output, subject_effects, args.dpi)
    atomic_json(
        output / "analysis_manifest.json",
        {
            "game": int(args.game), "subjects": subjects,
            "n_subjects": len(subjects), "max_t_enabled": bool(args.max_t),
            "inference": "exact sign-flip across subject-mean effects; BH within scenario",
        },
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--subject", type=parse_subject)
    mode.add_argument("--aggregate-subjects", type=str)
    parser.add_argument("--game", type=int, choices=(1, 2), required=True)
    parser.add_argument("--shared-cache-root", type=Path, default=DEFAULT_SHARED_CACHE_ROOT)
    parser.add_argument("--output-root", type=Path, default=DEFAULT_OUTPUT_ROOT)
    parser.add_argument("--dpi", type=int, default=200)
    parser.add_argument("--max-t", action="store_true", help="add exact within-scenario max-|T| correction when <=16 units")
    return parser


def main() -> None:
    configure_style()
    args = build_parser().parse_args()
    if args.subject is not None:
        run_subject(args)
    else:
        run_aggregate(args)


if __name__ == "__main__":
    main()
