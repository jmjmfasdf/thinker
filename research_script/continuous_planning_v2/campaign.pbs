#!/bin/bash
#PBS -N continuous-v2
#PBS -q workq
#PBS -r n
#PBS -l select=1:ncpus=8:mem=32gb:host=bml2-slave5
#PBS -l walltime=168:00:00
#PBS -j oe
set -euo pipefail
case "$(hostname -s)" in bml2-slave[5-8]) ;; *) echo 'Only slave5-8 permitted'; exit 2 ;; esac
REPO=/home/jeongmin/thinker-dynamic-imitation
OUT=${V2_OUTPUT:?required}
V1=${V2_INPUT:?required}
SOURCE=${V2_SOURCE:?required}
SUBJECT=${V2_SUBJECT:?required}
GAME=${V2_GAME:?required}
ENV_DIR=/home/jeongmin/vbenv-25d766c04fe7
SIF=/home/jeongmin/ubuntu-24.04-amd64-1e0a86e57d24.sif
LOCAL=$(mktemp -d "/dev/shm/cpv2.${PBS_JOBID}.XXXXXX")
trap 'rm -rf -- "$LOCAL"' EXIT
cd "$SOURCE"
sha256sum -c SHA256SUMS
PY=(/usr/local/bin/singularity exec --cleanenv
  --bind "$REPO:$REPO:ro" --bind "$OUT:$OUT:rw" --bind "$SOURCE:$SOURCE:ro"
  --bind "$V1:$V1:ro" --bind "$ENV_DIR:$ENV_DIR:ro" --bind "$LOCAL:$LOCAL:rw"
  --env PYTHONDONTWRITEBYTECODE=1 --env PYTHONNOUSERSITE=1 --env PYTHONHASHSEED=0
  --env "LD_LIBRARY_PATH=$ENV_DIR/lib" --env "TMPDIR=$LOCAL" --env "MPLCONFIGDIR=$LOCAL/matplotlib"
  --env CUDA_VISIBLE_DEVICES= --env OMP_NUM_THREADS=2 --env OPENBLAS_NUM_THREADS=2
  --env MKL_NUM_THREADS=2 --env NUMEXPR_NUM_THREADS=2
  "$SIF" "$ENV_DIR/bin/python" -B -u)
SCRIPT=research_script/continuous_planning_v2
TAG=$(printf 'sub%03d_game%d' "$SUBJECT" "$GAME")
exec > >(tee -a "$OUT/jobs/$TAG.live.log") 2>&1
echo "started=$(date -Is) host=$(hostname) subject=$SUBJECT game=$GAME"
"${PY[@]}" "$SCRIPT/test_v2.py"
if [[ "$SUBJECT" == 0 ]]; then
  "${PY[@]}" "$SCRIPT/run.py" --stage group --v1-root "$V1" --output-root "$OUT"
else
  INDEX="$REPO/logs/visual_behav/heldout_5m_20260921/subjects/$TAG.json"
  "${PY[@]}" "$SCRIPT/run.py" --subject "$SUBJECT" --game "$GAME" --capture-index "$INDEX" \
    --v1-root "$V1" --output-root "$OUT"
fi
echo "completed=$(date -Is)"
